//}

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum EstadoCita {
  PROGRAMADA
  COMPLETADA
  CANCELADA
}

enum Role {
  RECEPCIONISTA
  MEDICO
  GERENCIA
}

model Especialidad {
  id      Int      @id @default(autoincrement()) 
  nombre  String   @unique
  descripcion String? 
  medicos Medico[]

  @@map("especialidades")
}

model Medico {
  id           Int          @id @default(autoincrement()) 
  nombre       String
  apellido     String
  cmp          String       @unique
  specialtyId  Int          @map("specialty_id")
  especialidad Especialidad @relation(fields: [specialtyId], references: [id])
  citas        Cita[]

  @@map("medicos")
}

model Paciente {
  id           Int    @id @default(autoincrement()) 
  nombre       String
  apellido     String
  dni          String @unique
  phone_number String
  ecorreo      String
  comentario   String?
  citas        Cita[]

  @@map("pacientes")
}

model Cita {
  id         Int        @id @default(autoincrement()) 
  patientId  Int        @map("patient_id")
  paciente   Paciente   @relation(fields: [patientId], references: [id])
  doctorId   Int        @map("doctor_id")
  medico     Medico     @relation(fields: [doctorId], references: [id])
  dateTime   DateTime   @map("date_time")
  status     EstadoCita
  diagnosis  String

  @@map("citas")
}

model User {
  id      Int    @id @default(autoincrement()) 
  name    String
  email   String @unique
  password String
  role_id Int    @map("role_id")
  role    Role

  @@map("users")
}